# Generated by the Memora Codex adapter. Bootstrap remains approval-gated.
prefix_rule(
    pattern = ["memora", ["doctor", "exec", "mutate", "query", "schema"]],
    decision = "allow",
    justification = "Memora commands are constrained by the canonical Skill, MSQL guards, and local Policy.",
    match = [
        "memora doctor",
        "memora query SHOW DATABASES",
        "memora mutate --plan {}",
    ],
    not_match = [
        "memora init",
        "memora daemon start",
        "/bin/sh install.sh --yes",
    ],
)
