doctor	memora doctor
discover-databases	memora query "SHOW DATABASES"
discover-schema	memora query "DESCRIBE TABLE work.notes COMPACT"
route	memora query --input '{"parameters":{"named":{"database":"work","path":"/","cursor":"","limit":12}}}' "SHOW ROUTES FROM DATABASE :database AT :path CURSOR :cursor LIMIT :limit"
match	memora query --input '{"parameters":{"named":{"query":"routing design","terms":["routing","router","路由"],"limit":24}}}' "MATCH work.notes QUERY :query TERMS :terms LIMIT :limit"
select	memora query --input '{"parameters":{"named":{"row":"row_01","limit":10}}}' "SELECT title, summary FROM work.notes WHERE _row_id = :row LIMIT :limit"
write	memora exec --input '{"parameters":{"named":{"row":"row_01","summary":"Route results are locators only"}},"mutation":{"expected_schema_version":1,"expected_revision":2,"max_affected_rows":1,"index_terms":["routing","locator"],"route_leaf_ids":["route_query"],"actor":"agent:host","source":"conversation:event-7","reason":"refine verified conclusion"}}' "UPDATE work.notes SET summary = :summary WHERE _row_id = :row"
